<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#EFEFEF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💧 نظام إدارة مشروع المياه الذكي"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        android:paddingBottom="40dp"
        android:gravity="center"/>

    <!-- زر الانتقال لواجهة العامل -->
    <Button
        android:id="@+id/btnOpenWorker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👷 واجهة العامل الميداني"
        android:backgroundTint="#00897B"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="15dp"/>

    <!-- زر الانتقال لوحة تحكم المدير -->
    <Button
        android:id="@+id/btnOpenManager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📊 لوحة تحكم المدير والشؤون المالية"
        android:backgroundTint="#1976D2"
        android:textColor="#FFFFFF"
        android:padding="12dp"/>

</LinearLayout>
