<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="شاشة العامل الميداني - تسجيل القراءات"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#333333"
        android:paddingBottom="20dp"/>

    <!-- حقل إدخال رقم العداد أو المشترك -->
    <EditText
        android:id="@+id/etMeterNo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="أدخل رقم العداد أو اسم المشترك"
        android:inputType="text"
        android:padding="12dp"/>

    <!-- حقل إدخال القراءة الحالية -->
    <EditText
        android:id="@+id/etCurrentReading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="أدخل القراءة الحالية للعداد"
        android:inputType="number"
        android:padding="12dp"
        android:layout_marginTop="10dp"/>

    <!-- زر الحساب والطباعة -->
    <Button
        android:id="@+id/btnCalculateAndPrint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="حساب الاستهلاك وتوليد الفاتورة"
        android:backgroundTint="#00897B"
        android:textColor="#FFFFFF"
        android:layout_marginTop="20dp"/>

    <!-- مكان عرض النتيجة -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="نتيجة الحساب ستظهر هنا..."
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        android:padding="10dp"/>

</LinearLayout>
