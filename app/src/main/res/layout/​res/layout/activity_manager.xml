<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FAFAFA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="لوحة تحكم المدير - الشؤون المالية"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#2E7D32"
        android:paddingBottom="20dp"/>

    <!-- حقل إدخال المبلغ -->
    <EditText
        android:id="@+id/etAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="أدخل المبلغ (مصروف أو راتب)"
        android:inputType="numberDecimal"
        android:padding="12dp"/>

    <!-- أزرار العمليات المالية -->
    <Button
        android:id="@+id/btnAddExpense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إضافة مصروف جديد"
        android:backgroundTint="#D32F2F"
        android:textColor="#FFFFFF"
        android:layout_marginTop="15dp"/>

    <Button
        android:id="@+id/btnAddSalary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تسجيل راتب موظف أو سلفة"
        android:backgroundTint="#F57C00"
        android:textColor="#FFFFFF"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnViewReport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="عرض التقرير المالي وصافي الأرباح"
        android:backgroundTint="#1976D2"
        android:textColor="#FFFFFF"
        android:layout_marginTop="10dp"/>

    <!-- شاشة عرض النتائج والتقارير -->
    <TextView
        android:id="@+id/tvFinancialReport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="التقارير المالية ستظهر هنا..."
        android:textSize="15sp"
        android:layout_marginTop="20dp"
        android:padding="12dp"
        android:background="#E0F7FA"/>

</LinearLayout>
